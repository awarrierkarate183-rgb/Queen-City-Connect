PORT=8000
HOST=0.0.0.0
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-string
BASE_URL=https://queencityconnect.org

# Local JSON directory (resources.json, auth-config.json). Not used for accounts.
DATA_DIR=./data

# Turso (required) — hosted SQLite for accounts and sessions
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Allowed browser origins for credentialed API calls
CORS_ORIGINS=https://queencityconnect.org,https://www.queencityconnect.org

# Password for /admin.html user list (required in production to view accounts)
ADMIN_PASSWORD=

# Resource directory auto-update
# OpenStreetMap Overpass is free and needs no key.
# Optional Groq key (starts with gsk_) rewrites blurbs for high school
# students and tags volunteer / intern / help. Without it, listings still update.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Sign in with Google
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins (required for the GIS button):
#   https://queencityconnect.org
#   https://www.queencityconnect.org
#   http://127.0.0.1:8000
#   http://localhost:8000
# Authorized redirect URIs (required if GOOGLE_CLIENT_SECRET is set):
#   https://queencityconnect.org/api/auth/google/callback
#   https://www.queencityconnect.org/api/auth/google/callback
#   http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Gmail SMTP for welcome emails and password reset
# Use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# New accounts also notify NOTIFY_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

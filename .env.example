PORT=8000
SESSION_SECRET=change-this-to-a-long-random-string
BASE_URL=http://127.0.0.1:8000

# Resource directory auto-update
# OpenStreetMap Overpass is free and needs no key.
# Optional Groq key (starts with gsk_) rewrites blurbs for high school
# students and tags volunteer / intern / help. Without it, listings still update.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional — Sign in with Google
# Create an OAuth 2.0 Web client in Google Cloud Console.
# Authorized JavaScript origins:
#   http://127.0.0.1:8000
#   http://localhost:8000
# Authorized redirect URI (only needed if you also set GOOGLE_CLIENT_SECRET):
#   http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — Gmail SMTP for welcome emails and password reset
# Use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# New accounts also notify NOTIFY_EMAIL.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=queencityconnect674@gmail.com
